<?xml version="1.0" encoding="UTF-8"?>
<!--
  findery — Windows installer (WiX v4+ schema, built with `wix build`).

  Reads, relative to the working directory: artifacts/{findery,finderyd,findery-mcp}.exe
  and README.md. Installs them side by side into C:\Program Files\findery, and
  that directory onto the system PATH.

  Side by side is a correctness requirement, not tidiness: `findery` looks for
  `finderyd` next to itself before PATH, so the pair cannot come from two builds.

  GUIDs are STABLE FOR LIFE — they are the identity Windows Installer knows this
  package and its components by. Regenerating either duplicates instead of
  replacing. `$(Version)` comes from `wix build -d Version=x.y.z`, so this file
  holds no version that could drift from the tag.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="findery"
           Manufacturer="findery"
           Version="$(Version)"
           UpgradeCode="D5F0CF7C-E158-4906-A789-B087524653F8"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500"
           Language="1033">

    <SummaryInformation Description="findery $(Version) — local semantic index for codebases"
                        Manufacturer="findery" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of findery is already installed. Uninstall it first, or use Apps &amp; features to remove it." />

    <MediaTemplate EmbedCab="yes" />

    <!-- `finderyd` starts itself and stays up, and Windows will not replace a
         running executable — so without this, every upgrade lands on a locked
         file. The Restart Manager closes it first. No close message (it has no
         window) and no reboot prompt (a tool you restart by typing its name
         must never ask for one). -->
    <util:CloseApplication Id="CloseServer"
                           Target="finderyd.exe"
                           CloseMessage="no"
                           RebootPrompt="no" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="findery" />
    </StandardDirectory>

    <Feature Id="Main" Title="findery" Level="1" Display="expand"
             Description="The CLI, the index server and the Claude Code bridge.">
      <ComponentGroupRef Id="Binaries" />
      <ComponentRef Id="InstallDirRegistry" />
      <ComponentRef Id="Readme" />
    </Feature>

  </Package>

  <Fragment>
    <ComponentGroup Id="Binaries" Directory="INSTALLFOLDER">

      <!-- One component per file: an upgrade then replaces exactly the
           binaries, and each component keeps its single keypath. -->

      <Component Id="Cli" Guid="DC47CB50-7612-4EE7-9BAC-DEA28E5175E9">
        <File Id="findery_exe" Source="artifacts/findery.exe" Name="findery.exe" KeyPath="yes" />

        <!-- PATH is the reason this package exists: the tool is typed from
             inside a project, not from an install directory. Appended, so an
             existing PATH keeps its order and its precedence; system-wide,
             matching `Scope="perMachine"`; and tied to this component, so
             uninstalling removes it and nothing else does. -->
        <Environment Id="PathEntry"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Action="set"
                     Part="last"
                     System="yes"
                     Permanent="no" />
      </Component>

      <Component Id="Server" Guid="B067DF76-6444-4E30-838E-554F392A06A4">
        <File Id="finderyd_exe" Source="artifacts/finderyd.exe" Name="finderyd.exe" KeyPath="yes" />
      </Component>

      <Component Id="McpBridge" Guid="CE0305AE-5F42-4034-8D7A-A7A1A2B33D3F">
        <File Id="findery_mcp_exe" Source="artifacts/findery-mcp.exe" Name="findery-mcp.exe" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- A breadcrumb: a process started before the PATH change has not
         reloaded it, and `findery doctor` should still find the install. -->
    <Component Id="InstallDirRegistry" Guid="AA8AF7E0-FF3C-45D4-B47E-2F907D6505B3"
               Directory="INSTALLFOLDER">
      <RegistryKey Root="HKLM" Key="Software\findery">
        <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </RegistryKey>
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="Readme" Guid="29C5E6C7-6381-4199-A66C-BA6816ADFE20"
               Directory="INSTALLFOLDER">
      <File Id="readme_md" Source="README.md" Name="README.md" KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
