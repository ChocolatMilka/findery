# Copy to `.env` and edit. Every value here is also a plain environment
# variable, so nothing in this file is required to run the daemon by hand.

# ---------------------------------------------------------------------------
# ALL-DOCKER MODE ONLY — where your repositories live on the host.
#
# Ignore this entirely if you run the daemon natively (`make up-model` +
# `findery`), which is the default: the daemon then sees your real
# filesystem and a project can live on any disk.
#
# This directory is bind-mounted read-only at /workspaces inside the container.
# It does two jobs:
#   1. it is the SECURITY BOUNDARY — the daemon can only ever read what is under
#      it, so a bad path in an API call cannot reach the rest of your disk;
#   2. it anchors FINDERY_MOUNTS, which translates container paths back to host paths
#      so every search hit cites something you can actually open.
#
# Point it at the PARENT of your repositories, not at one repository.
# Projects on another drive: see docker-compose.override.yml.example.
# Changing it needs `docker compose up -d` (recreates the container, keeps the
# index — the bucket lives in the `findery-data` volume, not in the container).
# ---------------------------------------------------------------------------
FINDERY_WORKSPACES=C:/Users/users/RustroverProjects

# Published port of the daemon.
FINDERY_PORT=8077

# Leave empty for a trusted single-user machine. Set it and every request needs
# `Authorization: Bearer <token>` — except /healthz.
FINDERY_API_TOKEN=

FINDERY_LOG=info,tower_http=warn

# ---------------------------------------------------------------------------
# EMBEDDING MODEL — nothing is hardcoded. Pick one of the blocks below.
# ---------------------------------------------------------------------------

# (A) DashScope — the default. `qwen3.7-text-embedding` is served by the API;
#     it has no Hugging Face weights, so no container can host it.
#     131K context, $0.07 / 1M tokens.
FINDERY_EMBED_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode
FINDERY_EMBED_MODEL=qwen3.7-text-embedding
FINDERY_EMBED_API_KEY=
FINDERY_EMBED_DIM=1024
FINDERY_EMBED_BATCH_SIZE=32
FINDERY_EMBED_CONCURRENCY=2
# The width is yours to pick: 256, 512, 768, 1024, 1536, 2048 or 2560.
# A wider vector costs disk and scan time, not tokens. Changing it changes the
# recipe, and a recipe change is a re-index.
#
# The `tei` container below serves a LOCAL model and cannot serve this one;
# FINDERY_TEI_MODEL_ID is its own setting for that reason.
# Pin the runtime image if the default tag ever drifts:
# FINDERY_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
# FINDERY_TEI_GPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.8
# Needed only for gated weights:
# HF_TOKEN=

# (B) Another local runtime you already have — llama.cpp, Ollama, LM Studio,
#     vLLM, Infinity. Anything serving OpenAI-compatible /v1/embeddings works.
#     `host.docker.internal` reaches the host from inside the container.
# FINDERY_EMBED_BASE_URL=http://host.docker.internal:11434
# FINDERY_EMBED_MODEL=<the name your local runtime reports>
# FINDERY_EMBED_DIM=1024

# (C) A remote provider. Same client, different URL and a key.
#
# DashScope at its widest vector — same model as (A), 2560 dims.
# FINDERY_EMBED_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode
# FINDERY_EMBED_MODEL=qwen3.7-text-embedding
# FINDERY_EMBED_DIM=2560
# FINDERY_EMBED_SEND_DIMENSIONS=true
# FINDERY_EMBED_SEND_DIMENSIONS=true
# FINDERY_EMBED_API_KEY=sk-...
# Beijing region: https://dashscope.aliyuncs.com/compatible-mode
#
# FINDERY_EMBED_BASE_URL=https://api.openai.com
# FINDERY_EMBED_MODEL=text-embedding-3-large
# FINDERY_EMBED_DIM=3072
# FINDERY_EMBED_API_KEY=sk-...
# FINDERY_EMBED_SEND_DIMENSIONS=true          # Matryoshka truncation, where supported
# FINDERY_EMBED_HEADERS=OpenAI-Organization: org-123
#
# Azure OpenAI wants a different auth header:
# FINDERY_EMBED_AUTH_HEADER=api-key
# FINDERY_EMBED_AUTH_PREFIX=
#
# A remote GPU box running TEI behind TLS:
# FINDERY_EMBED_BASE_URL=https://embed.internal.example
# FINDERY_EMBED_API_KEY=...

# Changing the model or the dimension starts a NEW vector namespace. The daemon
# refuses to mix recipes in one bucket and tells you so at startup; point
# FINDERY_DATA_DIR elsewhere, or delete the bucket, to re-index.

# ---------------------------------------------------------------------------
# VECTOR STORE — where the vectors are written.
# ---------------------------------------------------------------------------
# sqlite : vectors next to the bucket, searched from a warm in-memory matrix.
#          Exact, no extra service. ~11 ms at 50k chunks, ~47 ms at 200k (1024
#          dims, measured — see `cargo run -p findery-bench --release`).
# qdrant : a local vector database with HNSW and int8 quantization. Start it
#          with `docker compose --profile qdrant up -d`.
FINDERY_STORE_BACKEND=sqlite
# FINDERY_QDRANT_URL=http://127.0.0.1:6333   # http://qdrant:6333 from inside compose
# FINDERY_QDRANT_API_KEY=
# FINDERY_QDRANT_PORT=6333

# ---------------------------------------------------------------------------
# WHAT GETS INDEXED
# ---------------------------------------------------------------------------
# Extensions retained by default, for every project that does not override them.
# Empty means "everything that passes the exclude globs"; files that are not
# valid UTF-8 are skipped and reported, never indexed as garbage.
# FINDERY_EXTENSIONS=rs,md,toml,yml,sh
#
# Dotfiles and dot-directories. ON by default: .github/workflows, .cargo/ and
# .claude/docs are exactly what you want searchable. The default exclude list
# keeps .env, .ssh, keys and certificates out.
# FINDERY_INCLUDE_HIDDEN=true

# ---------------------------------------------------------------------------
# CHUNKING — bigger chunks mean fewer, broader excerpts.
# ---------------------------------------------------------------------------
# FINDERY_CHUNK_MAX_CHARS=2400
# FINDERY_CHUNK_MIN_CHARS=120
# FINDERY_CHUNK_OVERLAP_CHARS=200
